# Copy to `.env` and fill in your Hugging Face token, then export it before
# `docker run` (see LLAVA_EXPERIMENT_GUIDE.md).
#
#   cp .env.example .env
#   # edit .env, then:
#   export $(grep -v '^#' .env | xargs)
#   docker run --rm --gpus all -e HF_TOKEN=$HF_TOKEN -e SMOKE=1 ... lvlm-llava
#
# HF_TOKEN is required: llava-hf/llava-1.5-7b-hf and COCO Karpathy are PUBLIC,
# but ILSVRC/imagenet-1k (the zero-shot eval set) is GATED and needs the token
# (accept the dataset terms once at https://huggingface.co/datasets/ILSVRC/imagenet-1k).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Not used by this pipeline; present only because the repo's .env carries it.
# OPENAI_API_KEY=sk-xxxxxxxx
